# Copy this file to ble_scanner.local.env after provisioning a receiver.
BLE_BACKEND_URL=http://127.0.0.1:8000/iot/api/ble
BLE_RECEIVER_ID=phase-1-laptop
BLE_RECEIVER_KEY=paste-the-one-time-provisioned-key-here

# Phase 1 DX-CP101 filters. Device name is optional because some advertisement
# frames may omit it.
BLE_TARGET_UUID=E2C56DB5-DFFB-48D2-B060-D0F5A71096E0
BLE_TARGET_MAC=48:87:2D:9E:3E:95
# BLE_TARGET_NAME=CP101-3E95

# Windows uses active discovery. This remains connectionless and never pairs.
BLE_SCAN_MODE=active
BLE_SMOOTHING_METHOD=median
BLE_SMOOTHING_WINDOW=5
BLE_REPORT_INTERVAL_SECONDS=1
BLE_RESTART_INTERVAL_SECONDS=300
BLE_BACKEND_TIMEOUT_SECONDS=5
BLE_BACKEND_QUEUE_SIZE=100
